# ============================================================================
# Cymbal Enterprise AI Hub: Google ADK 2.0 & Gemini Enterprise Configuration (.env)
# ============================================================================

# 1. Target Google Cloud Project & Region
PROJECT_ID="<YOUR_PROJECT_ID>"
GOOGLE_CLOUD_PROJECT="<YOUR_PROJECT_ID>"
REGION="us-central1"

# 2. ADK Root Coordinator Agent Model & Execution Mode
AGENT_MODEL="gemini-2.5-flash"
# Set USE_ADK_LLM="true" to execute live Gemini 2.5 Flash Function Calling via ADK InMemoryRunner
# Automatically falls back to Deterministic Hybrid Router if offline or unauthenticated
USE_ADK_LLM="true"

# 3. Gateway 1: BigQuery FinOps Analytics Dataset
BQ_FINOPS_DATASET="enterprise_finops_gold"

# 4. Gateway 2: IT Security Policy Vector RAG Table
BQ_POLICY_TABLE="enterprise_finops_gold.it_security_policy_embeddings"

# 5. Gateway 3: IT Service Desk Telemetry & Quota Action Mode (MOCK or LIVE)
# Default is MOCK for zero-cost Cloud Shell / local lab verification
ITSM_MODE="MOCK"
ITSM_ENDPOINT_URL="https://itsm.enterprise.internal/api/v1"

# 6. Enterprise Audit & Observability Telemetry Dataset
BQ_TELEMETRY_DATASET="agent_telemetry"
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY="true"
